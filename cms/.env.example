# Copy to .env (local) or .env.production and fill in real values.
# Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=
DATABASE_URI=postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5434/mhd_payload

# Min 32 chars in production
PAYLOAD_SECRET=

NEXT_PUBLIC_SERVER_URL=http://localhost:3005
# Extra comma-separated origins allowed to call the CMS API with cookies
ALLOWED_ORIGINS=

PORT=3005

# Inquiry attachments — must be outside /public
PRIVATE_UPLOAD_DIR=private-uploads

# Demo certificates on /phap-ly/tra-cuu (dev default: on, prod default: off)
ENABLE_DEMO_CERTIFICATES=
